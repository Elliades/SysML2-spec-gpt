# Host port published as localhost:<port> (container always listens on 3112).
SYSML_HOST_PORT=3112

# Public-facing URL used in MCP / cite links. Change this to the hostname
# people will actually open (LAN IP, Tailscale name, reverse-proxy URL).
SYSML_VIEWER_URL=http://localhost:3112

# Spec stack to ingest on first boot: 2.0 | 2.1 | all
SYSML_SPEC_VERSION=2.0

# Optional: skip first-boot download (container starts even without an index).
# SYSML_SKIP_INGEST=1

# Optional: rebuild the index on the next start even if ./data/index exists.
# SYSML_INGEST_FORCE=1

# Optional: bind-mount another data directory (PDFs + sqlite + markdown).
# SYSML_DATA=./data

# Corporate proxy (uncomment if Docker / ingest cannot reach omg.org or PyPI).
# HTTP_PROXY=http://proxy.example:8080
# HTTPS_PROXY=http://proxy.example:8080
# NO_PROXY=localhost,127.0.0.1
